# Generated by HelloWM's install.sh. Import this module from your NixOS config.
{ pkgs, ... }:
let
  hellowmRunner = pkgs.writeShellScriptBin "hellowm" ''
    exec "@HELLOWM_BIN@" "$@"
  '';

  hellowmSession = pkgs.runCommand "hellowm-session" {
    providedSessions = [ "hellowm" ];
  } ''
    mkdir -p "$out/share/xsessions"
    cat > "$out/share/xsessions/hellowm.desktop" <<EOF_SESSION
[Desktop Entry]
Name=HelloWM
Comment=A minimal floating X11 desktop with a Windows-inspired taskbar
Exec=${hellowmRunner}/bin/hellowm
TryExec=${hellowmRunner}/bin/hellowm
Type=XSession
DesktopNames=HelloWM
EOF_SESSION
  '';
in
{
  services.displayManager.sessionPackages = [ hellowmSession ];
  environment.systemPackages = [ hellowmRunner ];
}
